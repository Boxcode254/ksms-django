# =============================================================================
# KSMS — Environment Variables (.env.example)
# Copy to .env and fill in real values. NEVER commit .env to version control.
# =============================================================================

# ─── Core ─────────────────────────────────────────────────────────────────────
SECRET_KEY=<generate-new-random-key>
DEBUG=False
ALLOWED_HOSTS=yourapp.up.railway.app,localhost
CSRF_TRUSTED_ORIGINS=https://yourapp.up.railway.app

# Demo / launch account controls (remove DEMO_MODE in production)
DEMO_MODE=False
DEMO_DEFAULT_PASSWORD=ChangeMe12345
DEMO_USERNAMES=
FINAL_SUPERUSER_USERNAME=
FINAL_SUPERUSER_EMAIL=

# Auto-created superuser on container start (used by ensure_superuser command)
DJANGO_SUPERUSER_USERNAME=admin.ksms
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=<strong-password-here>

# Database mode toggle (set True for local SQLite fallback)
USE_SQLITE=False

# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
DB_NAME=postgres
DB_USER=postgres.yourprojectref
DB_PASSWORD=<supabase-password>
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432

# Connection pooling (for Supabase PgBouncer)
CONN_MAX_AGE=60
CONN_HEALTH_CHECKS=True

# ─── Security ─────────────────────────────────────────────────────────────────
FIELD_ENCRYPTION_KEY=<generate-fernet-key>
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_AGE=86400

# Content Security Policy
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com
CSP_STYLE_SRC='self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com
CSP_IMG_SRC='self' data: https:
CSP_CONNECT_SRC='self'
CSP_FONT_SRC='self' https://cdnjs.cloudflare.com
CSP_FRAME_ANCESTORS='none'

# ─── Email (Resend) ──────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=<resend-api-key>
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# ─── Static & Media ───────────────────────────────────────────────────────────
STATIC_URL=/static/
MEDIA_URL=/media/
WHITENOISE_COMPRESSION_ENABLED=True
WHITENOISE_MANIFEST_STRICT=False

# CDN overrides (set to full CDN URL to serve from CDN)
CDN_STATIC_URL=
CDN_MEDIA_URL=

# ─── Caching ──────────────────────────────────────────────────────────────────
CACHE_DASHBOARD_SECONDS=300

# ─── Redis (Upstash) ─────────────────────────────────────────────────────────
CELERY_BROKER_URL=<upstash-redis-url>
CELERY_RESULT_BACKEND=<upstash-redis-url>

# ─── M-Pesa (Daraja API) ─────────────────────────────────────────────────────
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=<daraja-consumer-key>
MPESA_CONSUMER_SECRET=<daraja-consumer-secret>
MPESA_SHORTCODE=174379
MPESA_PASSKEY=<daraja-passkey>
MPESA_CALLBACK_TOKEN=ksms-daraja-callback-changeme
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_ACCOUNT_REFERENCE=KSMS-FEES
MPESA_BUSINESS_NAME=Kenya School MS
MPESA_TIMEOUT_SECONDS=20
# MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# ─── Africa's Talking (SMS) ──────────────────────────────────────────────────
AFRICASTALKING_ENABLED=False
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=<africastalking-api-key>
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_TIMEOUT_SECONDS=20

# ─── Celery / Redis ──────────────────────────────────────────────────────────
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=True

# Celery beat schedules
CELERY_SYNC_ARREARS_CRON_MINUTE=0
CELERY_SYNC_ARREARS_CRON_HOUR=2
CELERY_DAILY_REMINDER_CRON_MINUTE=30
CELERY_DAILY_REMINDER_CRON_HOUR=8
CELERY_WEEKLY_REMINDER_CRON_MINUTE=0
CELERY_WEEKLY_REMINDER_CRON_HOUR=9
CELERY_WEEKLY_REMINDER_DAY=1

# ─── Feature Toggles ─────────────────────────────────────────────────────────
ARREARS_ENABLED=True
MPESA_STK_ENABLED=False
AUTO_REMINDERS_ENABLED=False
SEND_PAYMENT_NOTIFICATIONS=False
REMINDER_EMAIL_ENABLED=False
REMINDER_DAILY_ENABLED=True
REMINDER_WEEKLY_ENABLED=True
REMINDER_OVERDUE_ESCALATION_DAYS=10
REMINDER_MIN_HOURS_BETWEEN_SENDS=24

# ─── Exports ──────────────────────────────────────────────────────────────────
EXPORT_ROW_LIMIT=5000

# ─── Monitoring (Sentry — optional) ──────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
